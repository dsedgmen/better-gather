From f0d6c1184f6fd1f9a3c027195ba8b9bde52614fd Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Mon, 19 Oct 2026 06:54:19 +1000
Subject: [PATCH 25/28] Keep the live log when nothing was written during the
 window

Reported against the CNV result: --since 5m collected zero QEMU logs for a
running VM, because that VM's log had last been written half an hour
earlier. Asked whether that was the right logic. It is not.

mtime says when a file was last *written*, not what period it covers. A log
that is still the live one for a running service covers the window whether
or not anything happened to be written during it, and "nothing was logged"
is itself worth knowing. Dropping it leaves nothing at all for that service,
which is the opposite of what a support collection is for. The same rule
would have emptied /var/log/ceph on an idle cluster -- the ODF case, where
it would have been much harder to notice.

The two filtering paths disagreed about this, which is how it slipped
through. filter_names_since has always kept entries whose names carry no
timestamp, with a comment calling that deliberate and load-bearing because
it preserves the live audit.log. since_find_predicate applied a bare
-newermt with no such carve-out.

A file is now in scope when it was written inside the window *or* it is not
an archived copy: rotated and compressed files carry a date, a .gz or a
trailing .N in the name, and a live log does not.

  cnv-test_bg-testvm.log  30m old, live      kept
  ceph-osd.1.log          30m old, live      kept
  ceph-mon.a.log           2m old            kept
  audit-2026-10-15T19-30-44.933.log          dropped
  ceph-osd.1.log.gz                          dropped
  messages.1                                 dropped

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 collection-scripts/since_common.sh | 26 ++++++++++++--
 tests/since_common.bats            | 55 ++++++++++++++++++++++++++++--
 2 files changed, 77 insertions(+), 4 deletions(-)

diff --git a/collection-scripts/since_common.sh b/collection-scripts/since_common.sh
index 421cc98..6d09a6f 100644
--- a/collection-scripts/since_common.sh
+++ b/collection-scripts/since_common.sh
@@ -138,10 +138,32 @@ since_window_requested() {
 #
 #   find /var/log/ovnkube -type f $(since_find_predicate) -name 'libovsdb*log*'
 #
+# A plain -newermt is not enough, and getting this wrong is easy to miss.
+# mtime says when a file was last *written*, not what period it covers. A log
+# that is still the live one for a running service covers the window whether
+# or not anything happened to be written during it -- and "nothing was
+# logged" is itself worth knowing. Dropping it leaves nothing at all for that
+# service, which is the opposite of helpful.
+#
+# Seen for real: a VM whose QEMU log was last written half an hour earlier
+# was dropped entirely by --since 5m, so the collection held no QEMU log for
+# a running VM. The same thing would empty /var/log/ceph on an idle cluster.
+#
+# So a file is in scope when it was written inside the window *or* it is not
+# an archived copy. Rotated and compressed files carry a date, a .gz, or a
+# trailing .N in the name; a live log does not. This is the same rule
+# filter_names_since applies to a listing, which until now the two paths
+# disagreed about.
 since_find_predicate() {
-	if since_window_requested; then
-		echo "-newermt @${since_cutoff_epoch}"
+	if ! since_window_requested; then
+		return 0
 	fi
+
+	printf '%s' \
+		"'(' -newermt @${since_cutoff_epoch} -o '!' '(' " \
+		"-name '*[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*' " \
+		"-o -name '*.gz' -o -name '*.[0-9]' -o -name '*.[0-9][0-9]' " \
+		"')' ')'"
 }
 
 # Echo the epoch seconds encoded in a log file name, or nothing when the name
diff --git a/tests/since_common.bats b/tests/since_common.bats
index 7100819..176f50c 100644
--- a/tests/since_common.bats
+++ b/tests/since_common.bats
@@ -180,7 +180,58 @@ load test_helper
 		since_find_predicate
 	"
 	assert_success
-	assert_output "-newermt @1792141200"
+	assert_output --partial "-newermt @1792141200"
+}
+
+@test "the window keeps a live log even when nothing was written during it" {
+	# mtime says when a file was last written, not what period it covers.
+	# A VM whose QEMU log was last written half an hour ago is still running,
+	# and dropping its only log leaves nothing at all for that VM. The same
+	# would empty /var/log/ceph on an idle cluster.
+	mkdir -p "$TEST_TMPDIR/logs"
+	touch -d '30 minutes ago' "$TEST_TMPDIR/logs/cnv-test_bg-testvm.log"
+	touch -d '30 minutes ago' "$TEST_TMPDIR/logs/ceph-osd.1.log"
+	touch -d '2 minutes ago' "$TEST_TMPDIR/logs/ceph-mon.a.log"
+
+	run bash -c "
+		export MUST_GATHER_SINCE=5m0s
+		source \"$SCRIPT_DIR/since_common.sh\"
+		get_since_cutoff
+		eval \"find '$TEST_TMPDIR/logs' -type f \$(since_find_predicate)\" | sed 's|.*/||' | sort
+	"
+	assert_success
+	assert_output "ceph-mon.a.log
+ceph-osd.1.log
+cnv-test_bg-testvm.log"
+}
+
+@test "the window still drops rotated and compressed copies" {
+	mkdir -p "$TEST_TMPDIR/rot"
+	touch -d '3 days ago' "$TEST_TMPDIR/rot/audit-2026-10-15T19-30-44.933.log"
+	touch -d '3 days ago' "$TEST_TMPDIR/rot/ceph-osd.1.log.gz"
+	touch -d '3 days ago' "$TEST_TMPDIR/rot/messages.1"
+	touch -d '3 days ago' "$TEST_TMPDIR/rot/live.log"
+
+	run bash -c "
+		export MUST_GATHER_SINCE=5m0s
+		source \"$SCRIPT_DIR/since_common.sh\"
+		get_since_cutoff
+		eval \"find '$TEST_TMPDIR/rot' -type f \$(since_find_predicate)\" | sed 's|.*/||' | sort
+	"
+	assert_success
+	# only the live one survives; the three archived copies do not
+	assert_output "live.log"
+}
+
+@test "the predicate is still empty without a window" {
+	run bash -c "
+		unset MUST_GATHER_SINCE MUST_GATHER_SINCE_TIME
+		source \"$SCRIPT_DIR/since_common.sh\"
+		get_since_cutoff
+		echo \"[\$(since_find_predicate)]\"
+	"
+	assert_success
+	assert_output "[]"
 }
 
 # =============================================================================
@@ -527,7 +578,7 @@ another plain line"
 		sh -c 'since_find_predicate'
 	"
 	assert_success
-	assert_output "-newermt @1792152000"
+	assert_output --partial "-newermt @1792152000"
 }
 
 @test "every public library function is exported" {
