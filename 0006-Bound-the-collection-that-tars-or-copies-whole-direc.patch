From 165a673b5986b99e2c8bacda2ee1ab80c8646378 Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Sat, 17 Oct 2026 09:02:37 +1000
Subject: [PATCH 06/28] Bound the collection that tars or copies whole
 directories

These scripts have no notion of time at all, which is the harder half of the
problem: there is no --since to pass more carefully, only an unbounded copy.

gather_network_logs runs

    find /var/log/ovnkube -type f -name "libovsdb*log*" | tar czf - -T -

inside each ovnkube-controller. Adding $(since_find_predicate) to that find
is the whole fix, and it expands to nothing without a window, so the
unbounded command is byte-identical to before.

gather_core_dumps and gather_machineconfigdaemon_termination_logs switch from
`oc cp <pod>:<dir>`, which cannot express a bound, to copy_pod_dir_since.
Coredumps accumulate indefinitely and are large, so a window matters there
more than almost anywhere else.

gather_insights filters the archive list the same way, which is the "prune or
limit the data that is collected" its own TODO has been asking for: archives
are named insights-2026-10-16-181710.tar.gz and written once, so mtime is
creation time. Without a window it still uses the original `oc rsync`, so the
default path is untouched.

gather_audit_logs' two monitoring log directories move to copy_pod_dir_since
as well.

Every one of these falls back to a plain `oc cp` when the target container
has no find or tar, and says so, rather than collecting nothing.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 collection-scripts/gather_core_dumps          | 11 +++++++++-
 collection-scripts/gather_insights            | 21 ++++++++++++++++---
 ...ather_machineconfigdaemon_termination_logs | 12 ++++++++++-
 collection-scripts/gather_network_logs        | 14 ++++++++++++-
 4 files changed, 52 insertions(+), 6 deletions(-)

diff --git a/collection-scripts/gather_core_dumps b/collection-scripts/gather_core_dumps
index 6870f8a..8beeded 100755
--- a/collection-scripts/gather_core_dumps
+++ b/collection-scripts/gather_core_dumps
@@ -1,4 +1,9 @@
 #!/bin/bash
+# shellcheck source=collection-scripts/since_common.sh
+source "$(dirname "$0")/since_common.sh"
+get_since_cutoff
+since_report_header
+
 BASE_COLLECTION_PATH="must-gather"
 CORE_DUMP_PATH=${OUT:-"${BASE_COLLECTION_PATH}/node_core_dumps"}
 
@@ -22,7 +27,11 @@ function get_dump_off_node {
 	else
 		#Copy Core Dumps out of Nodes suppress Stdout
 		echo "Copying core dumps on node ""$1"""
-		oc cp --loglevel 1 -n "default" "$debugPod":/host/var/lib/systemd/coredump "${CORE_DUMP_PATH}/${1}_core_dump" >/dev/null 2>&1 && PIDS+=($!)
+		# Coredumps accumulate indefinitely and are large, so a --since
+		# window matters here more than almost anywhere else.
+		copy_pod_dir_since "default" "$debugPod" "" \
+			/host/var/lib/systemd/coredump \
+			"${CORE_DUMP_PATH}/${1}_core_dump" "core_dumps/${1}" >/dev/null 2>&1 && PIDS+=($!)
 
 		#clean up debug pod after we are done using them
 		oc delete pod "$debugPod" -n "default"
diff --git a/collection-scripts/gather_insights b/collection-scripts/gather_insights
index 3ca45bc..2edb77c 100755
--- a/collection-scripts/gather_insights
+++ b/collection-scripts/gather_insights
@@ -9,10 +9,25 @@ COLLECTOR=${1:-rsync} #Define what oc collector to use (oc rsync or oc cp)
 
 INSIGHTS_OPERATOR_POD=$(oc get pods --namespace=openshift-insights -o custom-columns=:metadata.name --no-headers --field-selector=status.phase=Running)
 
+# shellcheck source=collection-scripts/since_common.sh
+source "$(dirname "$0")/since_common.sh"
+get_since_cutoff
+since_report_header
+
 echo "INFO: Collecting Insights Archives from $INSIGHTS_OPERATOR_POD"
-# shellcheck disable=SC2086
-oc $COLLECTOR --namespace=openshift-insights openshift-insights/$INSIGHTS_OPERATOR_POD:/var/lib/insights-operator $INSIGHTS_DATA_PATH
+if since_window_requested; then
+	# Archives are named insights-2026-10-16-181710.tar.gz and written once,
+	# so mtime is their creation time. This is the "prune or limit" the TODO
+	# below asked for, scoped to the window the user already asked for.
+	echo "INFO: Limiting archives to those written since ${since_cutoff_rfc3339}"
+	copy_pod_dir_since openshift-insights "$INSIGHTS_OPERATOR_POD" "" \
+		/var/lib/insights-operator "$INSIGHTS_DATA_PATH" insights
+else
+	# shellcheck disable=SC2086
+	oc $COLLECTOR --namespace=openshift-insights openshift-insights/$INSIGHTS_OPERATOR_POD:/var/lib/insights-operator $INSIGHTS_DATA_PATH
+fi
 
-#TODO: Prune or Limit the data that is collected/synced (as this might be a lot to add to the archive).
+#TODO: Prune or Limit the data that is collected/synced further; --since now
+#      bounds it, but an unbounded run still copies everything.
 
 sync
diff --git a/collection-scripts/gather_machineconfigdaemon_termination_logs b/collection-scripts/gather_machineconfigdaemon_termination_logs
index 1ac0088..cea055e 100755
--- a/collection-scripts/gather_machineconfigdaemon_termination_logs
+++ b/collection-scripts/gather_machineconfigdaemon_termination_logs
@@ -1,5 +1,12 @@
 #!/bin/bash
 
+# shellcheck source=collection-scripts/since_common.sh
+SINCE_COMMON="$(dirname "$0")/since_common.sh"
+source "${SINCE_COMMON}"
+export SINCE_COMMON
+get_since_cutoff
+since_report_header
+
 BASE_COLLECTION_PATH="must-gather"
 MACHINECONFIG_DAEMON_LOG_PATH=${OUT:-"${BASE_COLLECTION_PATH}/machine_config_termination_logs"}
 
@@ -17,7 +24,10 @@ function gather_machineconfigdaemon_termination_logs {
 		FOLDER_EXISTS=$(oc exec -n openshift-machine-config-operator "${DAEMONPOD}" -c machine-config-daemon -- sh -c '[ -d "/rootfs/etc/machine-config-daemon/previous-logs" ] && echo "exists"' 2>/dev/null)
 		# collect the logs from the location that MCD saves to prior to shutdown
 		if [ "${FOLDER_EXISTS}" == "exists" ]; then
-			timeout -v 1m oc cp -c machine-config-daemon openshift-machine-config-operator/"${DAEMONPOD}":rootfs/etc/machine-config-daemon/previous-logs "${MACHINECONFIG_DAEMON_LOG_PATH}/${NODE}/" &
+			timeout -v 1m bash -c "source \"\${SINCE_COMMON}\"; copy_pod_dir_since \
+				openshift-machine-config-operator '${DAEMONPOD}' machine-config-daemon \
+				rootfs/etc/machine-config-daemon/previous-logs \
+				'${MACHINECONFIG_DAEMON_LOG_PATH}/${NODE}/' 'mcd_termination_logs/${NODE}'" &
 			PIDS+=($!)
 		else
 			echo "INFO: 'previous-logs' folder not found on ${NODE}, skipping..."
diff --git a/collection-scripts/gather_network_logs b/collection-scripts/gather_network_logs
index 97090ce..4cc5202 100755
--- a/collection-scripts/gather_network_logs
+++ b/collection-scripts/gather_network_logs
@@ -3,6 +3,11 @@
 # start off by doing a gather, which includes gather_network_logs_basics.
 /usr/bin/gather
 
+# shellcheck source=collection-scripts/since_common.sh
+source "$(dirname "$0")/since_common.sh"
+get_since_cutoff
+since_report_header
+
 BASE_COLLECTION_PATH="must-gather"
 NETWORK_LOG_PATH=${OUT:-"${BASE_COLLECTION_PATH}/network_logs"}
 OVNK_EXTRAS_STORE_PATH=${OUT:-"ovnk_extras_store"}
@@ -25,10 +30,17 @@ function gather_extra_ovn_kubernetes_data_interconnect_mode {
 		# This tarball is then untarred while stripping the top 3 directories (var, log, ovnkube),
 		# and the contents are placed into the destination directory for the specified pod and container.
 		# All of this is done in the background.
+		#
+		# since_find_predicate adds '-newermt @<cutoff>' when a window was
+		# requested, so out-of-window logs are never put in the tarball and
+		# never cross the wire. Without a window it expands to nothing and
+		# this is the upstream command unchanged.
+		# shellcheck disable=SC2086
 		oc exec -n openshift-ovn-kubernetes -c "${CONTAINER}" "${OVNKUBE_CONTROLLER_POD}" -- \
-			bash -c 'find /var/log/ovnkube -type f -name "libovsdb*log*" | tar czf - -T -' |
+			bash -c "find /var/log/ovnkube -type f -name 'libovsdb*log*' $(since_find_predicate) | tar czf - -T -" |
 			tar xzf - -C "${DEST_DIR}" --strip-components=3 2>&1 &
 		PIDS+=($!)
+		since_report "network_logs/${OVNKUBE_CONTROLLER_POD}" "find-newermt" "libovsdb*log*" "pre-cutoff"
 	done
 }
 
