From 0ab12159647256f668558e3de744a8b48638c588 Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Sat, 17 Oct 2026 09:02:16 +1000
Subject: [PATCH 03/28] Let the test suite run without downloading anything
 from GitHub

hack/tools.sh fetches bats, shfmt, shellcheck, bats-support and bats-assert
from GitHub releases, so `make test` and `make lint` need network access to a
specific set of external hosts. That rules them out in environments
restricted to already-configured package repositories.

hack/tools-from-packages.sh gets the same tools from the distribution
instead, unpacking them under tmp/ with no root and nothing installed
system-wide. The Makefile's tool rule prefers it and falls back to
hack/tools.sh for anything the distribution does not carry, so this takes
nothing away.

bats-support and bats-assert are not packaged by Fedora or RHEL, and the
suite uses exactly four of their assertions. tests/bats_assert_fallback.bash
implements those four with the same signatures and comparable failure output;
test_helper.bash loads the real libraries when present and the fallback
otherwise, so no test needed changing and dropping the real libraries back in
is a no-op.

`make test` now bootstraps and passes from a clean checkout: 87 tests.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 Makefile                        |  17 +++-
 hack/tools-from-packages.sh     | 136 ++++++++++++++++++++++++++++++++
 tests/bats_assert_fallback.bash | 122 ++++++++++++++++++++++++++++
 tests/test_helper.bash          |  21 +++--
 4 files changed, 289 insertions(+), 7 deletions(-)
 create mode 100755 hack/tools-from-packages.sh
 create mode 100644 tests/bats_assert_fallback.bash

diff --git a/Makefile b/Makefile
index 2cb03f5..d01f6cb 100644
--- a/Makefile
+++ b/Makefile
@@ -66,5 +66,20 @@ TOOLS = bats \
 tools:
 	./hack/tools.sh
 
+# Prefer the distribution's packages over downloading release binaries from
+# GitHub: it works in environments restricted to already-configured package
+# repositories, and needs no root. hack/tools.sh remains the fallback for
+# anything the distribution does not carry.
+.PHONY: tools-from-packages
+tools-from-packages:
+	./hack/tools-from-packages.sh
+
 $(TOOLS):
-	./hack/tools.sh $@
+	@if [ -x "$(LOCALBIN)/$@" ]; then \
+		echo "$@ already present in $(LOCALBIN)"; \
+	elif ./hack/tools-from-packages.sh $@; then \
+		:; \
+	else \
+		echo "falling back to downloading $@"; \
+		./hack/tools.sh $@; \
+	fi
diff --git a/hack/tools-from-packages.sh b/hack/tools-from-packages.sh
new file mode 100755
index 0000000..e2fdd1e
--- /dev/null
+++ b/hack/tools-from-packages.sh
@@ -0,0 +1,136 @@
+#!/usr/bin/env bash
+#
+# Populate tmp/bin from already-configured package repositories.
+#
+# hack/tools.sh fetches bats, shfmt and shellcheck from GitHub releases. That
+# is not possible in an environment restricted to the package repositories
+# already configured on the machine, and it is not desirable in one that has
+# them packaged anyway.
+#
+# This script gets the same tools from the distribution instead. It does not
+# install anything system-wide and needs no root: the packages are downloaded
+# and unpacked under tmp/, which is already gitignored.
+#
+# bats-support and bats-assert are deliberately not handled. Neither is
+# packaged by Fedora or RHEL, and tests/bats_assert_fallback.bash provides
+# local equivalents of the assertions the suite uses, so the suite runs
+# without them.
+#
+# Usage:
+#   hack/tools-from-packages.sh              # all tools
+#   hack/tools-from-packages.sh bats         # just one
+#
+# Exits non-zero if a tool cannot be provided this way, so callers can fall
+# back to hack/tools.sh.
+
+set -eu -o pipefail
+
+PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+declare -r PROJECT_ROOT
+
+declare -r LOCAL_BIN="$PROJECT_ROOT/tmp/bin"
+declare -r RPM_CACHE="$PROJECT_ROOT/tmp/packages"
+declare -r RPM_ROOT="$PROJECT_ROOT/tmp/pkgroot"
+
+# tool -> package name
+package_for() {
+	case "$1" in
+	bats) echo "bats" ;;
+	shellcheck) echo "ShellCheck" ;;
+	shfmt) echo "shfmt" ;;
+	*) return 1 ;;
+	esac
+}
+
+require() {
+	command -v "$1" >/dev/null 2>&1 || {
+		echo "ERROR: $1 is required but not installed" >&2
+		return 1
+	}
+}
+
+fetch_package() {
+	local package="$1"
+
+	mkdir -p "$RPM_CACHE"
+	if compgen -G "$RPM_CACHE/${package}-*.rpm" >/dev/null; then
+		return 0
+	fi
+
+	echo "INFO: downloading ${package} from the configured repositories"
+	# --destdir keeps it out of the working tree; no root needed.
+	dnf download --quiet --destdir "$RPM_CACHE" "$package" >/dev/null 2>&1 || {
+		echo "ERROR: ${package} is not available from the configured repositories" >&2
+		return 1
+	}
+}
+
+unpack_package() {
+	local package="$1" rpm
+
+	mkdir -p "$RPM_ROOT"
+	for rpm in "$RPM_CACHE/${package}"-*.rpm; do
+		# Skip source rpms, which dnf download may also fetch.
+		case "$rpm" in
+		*.src.rpm) continue ;;
+		esac
+		rpm2cpio "$rpm" | (cd "$RPM_ROOT" && cpio -idm --quiet)
+	done
+}
+
+link_tool() {
+	local tool="$1" target
+
+	mkdir -p "$LOCAL_BIN"
+	target="$RPM_ROOT/usr/bin/$tool"
+	if [[ ! -x "$target" ]]; then
+		echo "ERROR: $tool not found in the unpacked package" >&2
+		return 1
+	fi
+
+	# Symlink rather than copy so the tool resolves its own installation
+	# root; bats in particular locates its libexec that way.
+	ln -sf "$target" "$LOCAL_BIN/$tool"
+	echo "OK: $tool -> $target"
+}
+
+install_tool() {
+	local tool="$1" package
+
+	package="$(package_for "$tool")" || {
+		echo "ERROR: unknown tool '$tool'" >&2
+		return 1
+	}
+
+	if [[ -x "$LOCAL_BIN/$tool" ]]; then
+		echo "OK: $tool already present in tmp/bin"
+		return 0
+	fi
+
+	fetch_package "$package"
+	unpack_package "$package"
+	link_tool "$tool"
+}
+
+main() {
+	require dnf
+	require rpm2cpio
+	require cpio
+
+	local tools=("$@")
+	if [[ ${#tools[@]} -eq 0 ]]; then
+		tools=(bats shellcheck shfmt)
+	fi
+
+	local tool
+	for tool in "${tools[@]}"; do
+		install_tool "$tool"
+	done
+
+	if [[ ! -d "$LOCAL_BIN/bats-assert" ]]; then
+		echo "INFO: bats-assert/bats-support are not packaged;" \
+			"tests/bats_assert_fallback.bash will be used instead"
+	fi
+}
+
+main "$@"
diff --git a/tests/bats_assert_fallback.bash b/tests/bats_assert_fallback.bash
new file mode 100644
index 0000000..daff5fd
--- /dev/null
+++ b/tests/bats_assert_fallback.bash
@@ -0,0 +1,122 @@
+#!/bin/bash
+# Minimal stand-ins for bats-support / bats-assert.
+#
+# Upstream's test_helper.bash loads those two libraries from tmp/bin, where
+# hack/tools.sh puts them after downloading them from GitHub releases. That is
+# not possible in an environment restricted to already-configured package
+# repositories, and neither library is packaged by Fedora or RHEL.
+#
+# bats itself *is* packaged, so the only thing missing is a handful of
+# assertions. These implement the four the test suite actually uses, with the
+# same signatures and the same failure output, so tests do not need changing
+# and the real libraries can be dropped in whenever they are available.
+#
+# Loaded by test_helper.bash only when the real libraries are absent.
+#
+# shellcheck disable=SC2154  # $status and $output are set by bats' `run`
+
+# assert_success
+#   Fail unless the last `run` exited 0.
+assert_success() {
+	if [ "${status}" -ne 0 ]; then
+		{
+			echo "-- command failed --"
+			echo "status : ${status}"
+			echo "output : ${output}"
+			echo "--"
+		} >&2
+		return 1
+	fi
+}
+
+# assert_failure [status]
+#   Fail if the last `run` exited 0, or did not exit with the given status.
+assert_failure() {
+	if [ "${status}" -eq 0 ]; then
+		{
+			echo "-- command succeeded, but it was expected to fail --"
+			echo "output : ${output}"
+			echo "--"
+		} >&2
+		return 1
+	fi
+	if [ "$#" -gt 0 ] && [ "${status}" -ne "$1" ]; then
+		{
+			echo "-- command failed with the wrong status --"
+			echo "expected : $1"
+			echo "actual   : ${status}"
+			echo "--"
+		} >&2
+		return 1
+	fi
+}
+
+# assert_output [--partial] <expected>
+#   With --partial, require the output to contain <expected>; otherwise
+#   require it to equal <expected> exactly.
+assert_output() {
+	local partial=0
+	if [ "${1:-}" = "--partial" ]; then
+		partial=1
+		shift
+	fi
+	local expected="${1:-}"
+
+	if [ "${partial}" -eq 1 ]; then
+		if [[ "${output}" == *"${expected}"* ]]; then
+			return 0
+		fi
+		{
+			echo "-- output does not contain substring --"
+			echo "substring : ${expected}"
+			echo "output    : ${output}"
+			echo "--"
+		} >&2
+		return 1
+	fi
+
+	if [ "${output}" = "${expected}" ]; then
+		return 0
+	fi
+	{
+		echo "-- output differs --"
+		echo "expected : ${expected}"
+		echo "actual   : ${output}"
+		echo "--"
+	} >&2
+	return 1
+}
+
+# refute_output [--partial] <expected>
+#   The inverse of assert_output.
+refute_output() {
+	local partial=0
+	if [ "${1:-}" = "--partial" ]; then
+		partial=1
+		shift
+	fi
+	local unexpected="${1:-}"
+
+	if [ "${partial}" -eq 1 ]; then
+		if [[ "${output}" != *"${unexpected}"* ]]; then
+			return 0
+		fi
+		{
+			echo "-- output should not contain substring --"
+			echo "substring : ${unexpected}"
+			echo "output    : ${output}"
+			echo "--"
+		} >&2
+		return 1
+	fi
+
+	if [ "${output}" != "${unexpected}" ]; then
+		return 0
+	fi
+	{
+		echo "-- output should have differed --"
+		echo "output : ${output}"
+		echo "--"
+	} >&2
+	return 1
+}
