From 8054545d26872b8354605724cdcf6699f3929c6d Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Sat, 17 Oct 2026 12:50:57 +1000
Subject: [PATCH 14/28] Push the images to ghcr.io

Pushes on main and on release-* branches, and on a v* tag. Pull requests
build and smoke-test but never publish.

  main          -> :latest and :main-<sha>
  release-4.18  -> :4.18 and :release-4.18
  v1.2.3        -> :v1.2.3 and :latest

A release branch deliberately does not move :latest, so pointing --image at
:4.18 keeps getting the 4.18 collection scripts whatever happens on main.

Built with buildx so the overlay can cover every architecture its base
offers. That matters for the CNV image, whose base is amd64, arm64 and
s390x; building only on the runner's architecture would quietly drop the
other two. Nothing is compiled here -- the Dockerfile is FROM and COPY only,
so the other platforms differ solely in their base layer and need no
emulation. The image that gets smoke-tested is still the native one, since
a multi-platform build cannot be loaded into the local docker.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .github/workflows/ci.yml | 64 +++++++++++++++++++++++++++++++---------
 1 file changed, 50 insertions(+), 14 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 2751e17..18c0de4 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -17,13 +17,14 @@ name: ci
 
 on:
   push:
-    branches: [main]
+    branches: [main, 'release-*']
     tags: ['v*']
   pull_request:
   workflow_dispatch:
 
 env:
   PUBLIC_BASE: quay.io/openshift/origin-must-gather:latest
+  PLATFORMS: linux/amd64
   IMAGE_NAME: better-gather
 
 jobs:
@@ -64,12 +65,20 @@ jobs:
     steps:
       - uses: actions/checkout@v4
 
-      - name: Build the overlay image
+      - uses: docker/setup-buildx-action@v3
+
+      - name: Build for this runner and load it, so it can be tested
+        # Multi-platform builds cannot be --load'ed into the local docker, so
+        # the image that gets smoke-tested is the native one. The Dockerfile
+        # is FROM + COPY only, so the other platforms differ solely in their
+        # base layer -- nothing is compiled, and nothing needs emulating.
         run: |
-          docker build \
+          docker buildx build \
+            --platform linux/amd64 \
             --build-arg BASE="$PUBLIC_BASE" \
             -f Dockerfile.overlay \
-            -t "$IMAGE_NAME:ci" .
+            -t "$IMAGE_NAME:ci" \
+            --load .
 
       - name: The collection scripts parse inside the image
         run: |
@@ -110,21 +119,48 @@ jobs:
             echo "in-image --since library OK"
           '
 
+      - name: Work out the tags
+        # main           -> :latest and :main-<sha>
+        # release-4.18    -> :4.18 and :release-4.18
+        # v* tag          -> :<tag> and :latest
+        #
+        # A release branch deliberately does not move :latest. Pointing
+        # --image at :4.18 should get you the 4.18 collection scripts
+        # whatever has happened on main since.
+        id: tags
+        run: |
+          REPO="ghcr.io/${{ github.repository_owner }}/$IMAGE_NAME"
+          REPO="$(echo "$REPO" | tr '[:upper:]' '[:lower:]')"
+          REF_NAME="${GITHUB_REF#refs/heads/}"
+          case "${GITHUB_REF}" in
+          refs/tags/v*)
+            TAGS="$REPO:${GITHUB_REF#refs/tags/},$REPO:latest"
+            ;;
+          refs/heads/release-*)
+            TAGS="$REPO:${REF_NAME#release-},$REPO:${REF_NAME}"
+            ;;
+          *)
+            TAGS="$REPO:latest,$REPO:main-${GITHUB_SHA::12}"
+            ;;
+          esac
+          echo "tags=$TAGS" >> "$GITHUB_OUTPUT"
+          echo "pushing: $TAGS"
+
       - name: Log in to ghcr.io
-        if: startsWith(github.ref, 'refs/tags/v')
+        if: github.event_name != 'pull_request'
         uses: docker/login-action@v3
         with:
           registry: ghcr.io
           username: ${{ github.actor }}
           password: ${{ secrets.GITHUB_TOKEN }}
 
-      - name: Push
-        # Only on a tag. Nothing is published by an ordinary push or PR.
-        if: startsWith(github.ref, 'refs/tags/v')
+      - name: Build every platform and push
+        # Pull requests build and test but never publish.
+        if: github.event_name != 'pull_request'
         run: |
-          TAG="${GITHUB_REF#refs/tags/}"
-          REPO="ghcr.io/${{ github.repository_owner }}/$IMAGE_NAME"
-          docker tag "$IMAGE_NAME:ci" "$REPO:$TAG"
-          docker tag "$IMAGE_NAME:ci" "$REPO:latest"
-          docker push "$REPO:$TAG"
-          docker push "$REPO:latest"
+          docker buildx build \
+            --platform "$PLATFORMS" \
+            --build-arg BASE="$PUBLIC_BASE" \
+            -f Dockerfile.overlay \
+            $(echo "${{ steps.tags.outputs.tags }}" | tr "," "\n" | sed "s/^/--tag /" | tr "\n" " ") \
+            --push .
-- 
