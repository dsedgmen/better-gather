#!/bin/bash

# generate /must-gather/version file
# shellcheck disable=SC1091
. version
echo "openshift/must-gather" >/must-gather/version
version >>/must-gather/version

# shellcheck source=collection-scripts/common.sh
source "$(dirname "$0")/common.sh"
get_log_collection_args

# Readable, sos-style progress instead of two dozen scripts interleaving
# their output into one unreadable stream.
# shellcheck source=collection-scripts/task_common.sh
source "$(dirname "$0")/task_common.sh"

# Every task this run will launch. Declared up front so the plan can be
# printed before anything starts; a mismatch between this list and the
# task_run calls below is reported by task_summary.
all_tasks=(
	core:named core:groups core:all-namespaces insights monitoring olm
	olm_v1 priority_and_fairness etcd service_logs windows_node_logs
	haproxy_config kas_startup_termination_logs network_logs_basics
	metallb frrk8s nmstate nfd sriov virt podnetworkconnectivitycheck
	machineconfig_ondisk machineconfigdaemon_termination_logs vsphere ppc
	osus istio aro
)
# Compression is part of the run only when REDUCE_LOGS asks for it, so it
# joins the plan on the same terms as everything else rather than happening
# silently after the summary.
if [ "${compress_after_gather}" = "true" ]; then
	all_tasks+=(compress)
fi
task_plan "${all_tasks[@]}"

# Named resource list, eg. ns/openshift-config
named_resources=()

# Resource groups list, eg. pods
group_resources=()

# Resources to gather with `--all-namespaces` option
all_ns_resources=()

# Cluster Version Information
named_resources+=(ns/openshift-cluster-version)
group_resources+=(clusterversion)

# Operator and APIService Resources
group_resources+=(clusteroperators apiservices)

# Certificate Resources
group_resources+=(certificatesigningrequests)

# Machine/Node Resources
group_resources+=(nodes)

# Namespaces/Project Resources
named_resources+=(ns/default ns/openshift ns/kube-system ns/openshift-etcd)

# Storage Resources
group_resources+=(storageclasses persistentvolumes volumeattachments csidrivers csinodes volumesnapshotclasses volumesnapshotcontents volumegroupsnapshotclasses volumegroupsnapshotcontents clustercsidrivers volumeattributesclasses)
all_ns_resources+=(csistoragecapacities)

# Image-source Resources
group_resources+=(imagecontentsourcepolicies.operator.openshift.io imagedigestmirrorsets.config.openshift.io imagetagmirrorsets.config.openshift.io)

# OS Image Stream Resources
group_resources+=(osimagestreams.machineconfiguration.openshift.io)

# Internal Release Image Resources
group_resources+=(internalreleaseimages.machineconfiguration.openshift.io)

# Networking Resources
group_resources+=(networks.operator.openshift.io)

# Two Node Fencing (Pacemaker) Resources
group_resources+=(pacemakerclusters.etcd.openshift.io)

# Assisted Installer
named_resources+=(ns/assisted-installer)

# Leases
all_ns_resources+=(leases)

# Flowcontrol - API Priority and Fairness (APF)
group_resources+=(prioritylevelconfigurations.flowcontrol.apiserver.k8s.io flowschemas.flowcontrol.apiserver.k8s.io)

# ClusterResourceQuota
group_resources+=(clusterresourcequotas.quota.openshift.io)

# Run the Collection of Resources using inspect
# running across all-namespaces for the few "Autoscaler" resources.
# shellcheck disable=SC2086
task_run core:named \
	oc adm inspect ${log_collection_args} --dest-dir must-gather ${rotated_pod_logs_arg} "${named_resources[@]}"

filtered_group_resources=()
for gr in "${group_resources[@]}"; do
	oc get "$gr" >/dev/null 2>&1
	# shellcheck disable=SC2181
	if [[ "$?" -eq 0 ]]; then
		filtered_group_resources+=("$gr")
	fi
done
group_resources_text=$(
	IFS=,
	echo "${filtered_group_resources[*]}"
)
# shellcheck disable=SC2086
task_run core:groups \
	oc adm inspect ${log_collection_args} --dest-dir must-gather ${rotated_pod_logs_arg} "${group_resources_text}"

all_ns_resources_text=$(
	IFS=,
	echo "${all_ns_resources[*]}"
)
# shellcheck disable=SC2086
task_run core:all-namespaces \
	oc adm inspect ${log_collection_args} --dest-dir must-gather ${rotated_pod_logs_arg} "${all_ns_resources_text}" --all-namespaces

# Gather Insights Operator Archives
task_run insights /usr/bin/gather_insights

# Gather monitoring data from the cluster
task_run monitoring /usr/bin/gather_monitoring

# Gather optional operator resources from all namespaces
task_run olm /usr/bin/gather_olm

# Gather OLM v1 resources
task_run olm_v1 /usr/bin/gather_olm_v1

# Gather API Priority and Fairness Endpoints
task_run priority_and_fairness /usr/bin/gather_priority_and_fairness

# Gather etcd information
task_run etcd /usr/bin/gather_etcd

# Gather Service Logs (using a supplemental Script); Scoped to Masters.
task_run service_logs /usr/bin/gather_service_logs master

# Gather Windows Kubernetes component logs
task_run windows_node_logs /usr/bin/gather_windows_node_logs

# Gather HAProxy config files
task_run haproxy_config /usr/bin/gather_haproxy_config

# Gather kas startup and termination logs
task_run kas_startup_termination_logs /usr/bin/gather_kas_startup_termination_logs

# Gather network logs
task_run network_logs_basics /usr/bin/gather_network_logs_basics

# Gather metallb logs
task_run metallb /usr/bin/gather_metallb

# Gather frr-k8s logs
task_run frrk8s /usr/bin/gather_frrk8s

# Gather NMState
task_run nmstate /usr/bin/gather_nmstate

# Gather Node Feature Discovery (NFD)
task_run nfd /usr/bin/gather_nfd

# Gather SR-IOV resources
task_run sriov /usr/bin/gather_sriov

# Gather basic Virtualization resources
task_run virt /usr/bin/gather_virt

# Gather PodNetworkConnectivityCheck
task_run podnetworkconnectivitycheck /usr/bin/gather_podnetworkconnectivitycheck

# Gather On-Disk MachineConfig files
task_run machineconfig_ondisk /usr/bin/gather_machineconfig_ondisk

# Gather On-Disk MachineConfigDaemon logs
task_run machineconfigdaemon_termination_logs /usr/bin/gather_machineconfigdaemon_termination_logs

# Gather vSphere resources. This is NOOP on non-vSphere platform.
task_run vsphere /usr/bin/gather_vsphere

# Gather Performance profile information (nodes already inspected above via group_resources)
task_run ppc env MUST_GATHER_NODES_INSPECTED=true /usr/bin/gather_ppc

# Gather OSUS information
task_run osus /usr/bin/gather_osus

# Gather Istio/Gateway API information
task_run istio /usr/bin/gather_istio

task_wait

# Gather ARO information. Serial, after the parallel phase, as upstream has
# it -- but still recorded so it shows up in the summary.
task_run aro /usr/bin/gather_aro
task_wait

# Compress collected log files before the sidecar copies them out, if
# REDUCE_LOGS asked for it. Run as a task so that gzipping several hundred
# megabytes shows up as progress rather than as a pause after the summary
# with nothing to say whether it is working.
if [ "${compress_after_gather}" = "true" ]; then
	task_run compress compress_logs
	task_wait
fi

task_summary || true

# force disk flush to ensure that all data gathered is accessible in the copy container
sync
