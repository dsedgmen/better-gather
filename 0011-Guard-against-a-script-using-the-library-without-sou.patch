From b1dd8c72320a876edbb18e181c42660d3c3bbf2c Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Sat, 17 Oct 2026 09:56:35 +1000
Subject: [PATCH 11/28] Guard against a script using the library without
 sourcing it

gather runs each gather_* as a separate script, so shell functions from a
parent are not inherited. Forgetting the source fails silently: the
collection runs, logs nothing unusual and gathers nothing. That is exactly
what happened on the first ODF cluster run -- 21 'copy_pod_dir_since:
command not found', three directories collected empty, and no sign of it in
gather-debug.log.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 tests/since_common.bats | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/tests/since_common.bats b/tests/since_common.bats
index e8d7995..90a04aa 100644
--- a/tests/since_common.bats
+++ b/tests/since_common.bats
@@ -495,3 +495,21 @@ another plain line"
 	assert_output --partial "cd / && find 'var/log/libvirt/qemu/' 'var/run/libvirt/qemu/log/'"
 	assert_output --partial "-newermt @"
 }
+
+@test "every script calling the library also sources it" {
+	# gather runs each gather_* as a separate script, so functions defined in
+	# a parent shell are not inherited. Forgetting the source is silent: the
+	# collection runs, logs nothing unusual, and gathers nothing. This cost a
+	# wasted cluster run in the ODF fork before it was caught.
+	cd "$SCRIPT_DIR"
+	local missing=""
+	for f in gather_*; do
+		if grep -qE '\b(copy_pod_dir_since|pod_tar_dirs_since|filter_names_since|since_find_predicate|trim_jsonl_since|since_report)\b' "$f"; then
+			grep -q 'since_common.sh' "$f" || missing="$missing $f"
+		fi
+	done
+	[ -z "$missing" ] || {
+		echo "scripts use the library but never source it:$missing" >&2
+		false
+	}
+}
