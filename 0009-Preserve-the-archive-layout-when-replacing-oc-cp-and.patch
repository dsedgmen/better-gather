From c27777ed384d322d729948c27f82b64c74384fef Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Sat, 17 Oct 2026 09:40:53 +1000
Subject: [PATCH 09/28] Preserve the archive layout when replacing oc cp and oc
 rsync

Found while mapping ODF's call sites. copy_pod_dir_since tarred the source
path as given, so an absolute path landed everything under <dest>/a/b/...
rather than where the command it replaced would have put it:

    oc cp pod:/a/b /dest   ->  /dest/b/...
    rsync pod:/a/b/ /dest  ->  /dest/...
    before this change     ->  /dest/a/b/...

It silently reshapes the archive, which is the kind of thing nobody notices
until they go looking for a file in a support case.

Both helpers now follow the same trailing-slash convention as rsync and oc
cp: a trailing slash copies the contents, no trailing slash copies the
directory itself. pod_tar_dirs_since, which tars several unrelated absolute
paths in one shot, makes them relative to / and extracts with that structure
intact, which is what its callers expect.

Four tests pin the path arithmetic with a stub oc, including that the
no-window path is still a plain oc cp with upstream's exact arguments.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 collection-scripts/since_common.sh | 39 ++++++++++----
 tests/since_common.bats            | 82 ++++++++++++++++++++++++++++++
 2 files changed, 112 insertions(+), 9 deletions(-)

diff --git a/collection-scripts/since_common.sh b/collection-scripts/since_common.sh
index 26c4ead..61bdb95 100644
--- a/collection-scripts/since_common.sh
+++ b/collection-scripts/since_common.sh
@@ -220,11 +220,21 @@ filter_names_since() {
 # say so, rather than collecting nothing.
 #
 # The container is optional; pass "" to use the pod's default container.
+#
+# Layout follows the same trailing-slash convention as rsync and oc cp, so a
+# call site keeps the output shape it had before:
+#
+#   src = /a/b   ->  <dest>/b/...     (the directory itself, like `oc cp`)
+#   src = /a/b/  ->  <dest>/...       (its contents, like `rsync src/ dest`)
+#
+# This matters: tarring an absolute path would land everything under
+# <dest>/a/b/... instead, silently reshaping the archive.
+#
 # Usage: copy_pod_dir_since <namespace> <pod> <container> <src-dir> <dest-dir> [label]
 copy_pod_dir_since() {
 	local ns="$1" pod="$2" container="$3" src="$4" dest="$5"
 	local label="${6:-${pod}}"
-	local predicate before after total
+	local predicate before after total chdir target
 	local -a c_arg=()
 
 	[ -n "${container}" ] && c_arg=(-c "${container}")
@@ -232,27 +242,35 @@ copy_pod_dir_since() {
 	mkdir -p "${dest}"
 
 	if ! since_window_requested; then
-		oc cp -n "${ns}" "${c_arg[@]}" "${pod}:${src}" "${dest}"
+		oc cp -n "${ns}" "${c_arg[@]}" "${pod}:${src%/}" "${dest}"
 		return $?
 	fi
 
+	if [ "${src}" != "${src%/}" ]; then
+		chdir="${src%/}"
+		target="."
+	else
+		chdir="$(dirname "${src}")"
+		target="$(basename "${src}")"
+	fi
+
 	if ! oc exec -n "${ns}" "${pod}" "${c_arg[@]}" -- \
 		sh -c 'command -v find >/dev/null 2>&1 && command -v tar >/dev/null 2>&1' 2>/dev/null; then
 		echo "INFO: ${label}: find/tar unavailable in ${pod}; copying ${src} whole" >&2
-		oc cp -n "${ns}" "${c_arg[@]}" "${pod}:${src}" "${dest}"
+		oc cp -n "${ns}" "${c_arg[@]}" "${pod}:${src%/}" "${dest}"
 		since_report "${label}" "unfiltered-fallback" "all" "0"
 		return $?
 	fi
 
 	total="$(oc exec -n "${ns}" "${pod}" "${c_arg[@]}" -- \
-		sh -c "find '${src}' -type f 2>/dev/null | wc -l" 2>/dev/null | tr -d '[:space:]')"
+		sh -c "cd '${chdir}' 2>/dev/null && find '${target}' -type f 2>/dev/null | wc -l" 2>/dev/null | tr -d '[:space:]')"
 	before="$(find "${dest}" -type f 2>/dev/null | wc -l)"
 
 	predicate="$(since_find_predicate)"
 
 	# shellcheck disable=SC2086
 	oc exec -n "${ns}" "${pod}" "${c_arg[@]}" -- \
-		sh -c "find '${src}' -type f ${predicate} -print0 2>/dev/null | tar czf - --null -T - 2>/dev/null" |
+		sh -c "cd '${chdir}' 2>/dev/null && find '${target}' -type f ${predicate} -print0 2>/dev/null | tar czf - --null -T - 2>/dev/null" |
 		tar xzf - -C "${dest}" 2>/dev/null
 
 	after="$(find "${dest}" -type f 2>/dev/null | wc -l)"
@@ -283,16 +301,19 @@ pod_tar_dirs_since() {
 
 	local dir
 	for dir in "$@"; do
-		quoted+=" '${dir}'"
+		# relative to / so tar records paths without a leading slash
+		quoted+="${quoted:+ }'${dir#/}'"
 	done
 
 	predicate="$(since_find_predicate)"
 
-	# -prune-less: just let find skip what does not exist, as tar
-	# --ignore-failed-read would.
+	# find skips what does not exist, as tar --ignore-failed-read would.
+	# tar is given -C / with relative member names so the absolute source
+	# paths are reproduced under dest, which is what the callers that tar
+	# several unrelated directories at once expect.
 	# shellcheck disable=SC2086
 	oc exec -n "${ns}" "${pod}" "${c_arg[@]}" -- \
-		sh -c "find ${quoted} -type f ${predicate} -print0 2>/dev/null | tar czf - --null -T - 2>/dev/null" |
+		sh -c "cd / && find ${quoted} -type f ${predicate} -print0 2>/dev/null | tar czf - --null -T - 2>/dev/null" |
 		tar xzf - -C "${dest}" 2>/dev/null
 
 	if since_window_requested; then
diff --git a/tests/since_common.bats b/tests/since_common.bats
index 8df5070..e8d7995 100644
--- a/tests/since_common.bats
+++ b/tests/since_common.bats
@@ -413,3 +413,85 @@ another plain line"
 	assert_output --partial "no-window"
 	assert_output --partial "predicate=[]"
 }
+
+# =============================================================================
+# copy_pod_dir_since() / pod_tar_dirs_since() layout
+# =============================================================================
+#
+# These exercise the path arithmetic only, with a stub oc. Getting it wrong
+# silently reshapes the archive: tarring an absolute path lands everything
+# under <dest>/a/b/... instead of where oc cp or rsync would have put it.
+
+@test "copy_pod_dir_since tars the directory itself without a trailing slash" {
+	run bash -c "
+		export MUST_GATHER_SINCE_TIME='2026-10-16T12:00:00Z'
+		export SINCE_REPORT_PATH=\"$TEST_TMPDIR/report.txt\"
+		mkdir -p \"$TEST_TMPDIR/mocks\"
+		printf '#!/bin/bash\necho \"\$*\" >>\"$TEST_TMPDIR/cmds\"\nexit 0\n' > \"$TEST_TMPDIR/mocks/oc\"
+		chmod +x \"$TEST_TMPDIR/mocks/oc\"
+		export PATH=\"$TEST_TMPDIR/mocks:\$PATH\"
+		source \"$SCRIPT_DIR/since_common.sh\"
+		get_since_cutoff
+		copy_pod_dir_since ns pod '' /a/b \"$TEST_TMPDIR/dest\" lbl >/dev/null 2>&1
+		grep -o \"cd '[^']*' .*find '[^']*'\" \"$TEST_TMPDIR/cmds\" | tail -1
+	"
+	assert_success
+	assert_output --partial "cd '/a'"
+	assert_output --partial "find 'b'"
+}
+
+@test "copy_pod_dir_since tars the contents with a trailing slash" {
+	run bash -c "
+		export MUST_GATHER_SINCE_TIME='2026-10-16T12:00:00Z'
+		export SINCE_REPORT_PATH=\"$TEST_TMPDIR/report.txt\"
+		mkdir -p \"$TEST_TMPDIR/mocks\"
+		printf '#!/bin/bash\necho \"\$*\" >>\"$TEST_TMPDIR/cmds\"\nexit 0\n' > \"$TEST_TMPDIR/mocks/oc\"
+		chmod +x \"$TEST_TMPDIR/mocks/oc\"
+		export PATH=\"$TEST_TMPDIR/mocks:\$PATH\"
+		source \"$SCRIPT_DIR/since_common.sh\"
+		get_since_cutoff
+		copy_pod_dir_since ns pod '' /a/b/ \"$TEST_TMPDIR/dest\" lbl >/dev/null 2>&1
+		grep -o \"cd '[^']*' .*find '[^']*'\" \"$TEST_TMPDIR/cmds\" | tail -1
+	"
+	assert_success
+	assert_output --partial "cd '/a/b'"
+	assert_output --partial "find '.'"
+}
+
+@test "copy_pod_dir_since falls back to oc cp without a window" {
+	run bash -c "
+		unset MUST_GATHER_SINCE MUST_GATHER_SINCE_TIME
+		export SINCE_REPORT_PATH=\"$TEST_TMPDIR/report.txt\"
+		mkdir -p \"$TEST_TMPDIR/mocks\"
+		printf '#!/bin/bash\necho \"\$*\" >>\"$TEST_TMPDIR/cmds\"\nexit 0\n' > \"$TEST_TMPDIR/mocks/oc\"
+		chmod +x \"$TEST_TMPDIR/mocks/oc\"
+		export PATH=\"$TEST_TMPDIR/mocks:\$PATH\"
+		source \"$SCRIPT_DIR/since_common.sh\"
+		get_since_cutoff
+		copy_pod_dir_since ns pod '' /a/b/ \"$TEST_TMPDIR/dest\" lbl >/dev/null 2>&1
+		cat \"$TEST_TMPDIR/cmds\"
+	"
+	assert_success
+	# unchanged upstream behaviour, and the trailing slash is dropped for oc cp
+	assert_output --partial "cp -n ns pod:/a/b"
+	refute_output --partial "find"
+}
+
+@test "pod_tar_dirs_since makes several absolute paths relative to /" {
+	run bash -c "
+		export MUST_GATHER_SINCE_TIME='2026-10-16T12:00:00Z'
+		export SINCE_REPORT_PATH=\"$TEST_TMPDIR/report.txt\"
+		mkdir -p \"$TEST_TMPDIR/mocks\"
+		printf '#!/bin/bash\necho \"\$*\" >>\"$TEST_TMPDIR/cmds\"\nexit 0\n' > \"$TEST_TMPDIR/mocks/oc\"
+		chmod +x \"$TEST_TMPDIR/mocks/oc\"
+		export PATH=\"$TEST_TMPDIR/mocks:\$PATH\"
+		source \"$SCRIPT_DIR/since_common.sh\"
+		get_since_cutoff
+		pod_tar_dirs_since ns pod compute \"$TEST_TMPDIR/dest\" lbl \
+			/var/log/libvirt/qemu/ /var/run/libvirt/qemu/log/ >/dev/null 2>&1
+		cat \"$TEST_TMPDIR/cmds\"
+	"
+	assert_success
+	assert_output --partial "cd / && find 'var/log/libvirt/qemu/' 'var/run/libvirt/qemu/log/'"
+	assert_output --partial "-newermt @"
+}
