From c15c32233c37d2cc17625ed7a870651f2b1e55b0 Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Sat, 17 Oct 2026 10:30:18 +1000
Subject: [PATCH 12/28] Export the library functions so they survive a sh -c
 fan-out

Collection scripts routinely fan out with 'xargs ... sh -c', and a function
defined in the parent shell is not visible in that grandchild. The failure
is quiet and expensive: $(since_find_predicate) expands to the empty string,
find runs unfiltered, and the window is silently ignored while everything
looks like it worked.

CNV's gather_vms_details does exactly this, and collected a 27-minute-old
QEMU log under --since 5m before this change. ODF's utils.sh already exports
its own shared functions for the same reason.

Two tests: that the predicate resolves inside sh -c, and that every public
function is marked exported.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 collection-scripts/since_common.sh | 19 +++++++++++++++++
 tests/since_common.bats            | 33 ++++++++++++++++++++++++++++++
 2 files changed, 52 insertions(+)

diff --git a/collection-scripts/since_common.sh b/collection-scripts/since_common.sh
index 61bdb95..421cc98 100644
--- a/collection-scripts/since_common.sh
+++ b/collection-scripts/since_common.sh
@@ -391,3 +391,22 @@ since_report_header() {
 }
 
 export SINCE_REPORT_PATH
+
+# Export the functions as well as the variables.
+#
+# Collection scripts routinely fan out with `xargs ... sh -c '...'`, and a
+# function defined in the parent is not visible in that grandchild. The
+# failure is quiet and expensive: `$(since_find_predicate)` becomes the empty
+# string, the find runs unfiltered, and the window is silently ignored. CNV's
+# gather_vms_details does exactly this, and ODF's utils.sh already exports its
+# own shared functions for the same reason.
+#
+# export -f is a bashism; skip it under a shell that lacks it rather than
+# erroring out.
+if [ -n "${BASH_VERSION:-}" ]; then
+	export -f duration_to_seconds duration_to_node_logs_since get_since_cutoff
+	export -f since_window_requested since_find_predicate
+	export -f filename_timestamp_epoch filter_names_since
+	export -f copy_pod_dir_since pod_tar_dirs_since trim_jsonl_since
+	export -f since_report since_report_header
+fi
diff --git a/tests/since_common.bats b/tests/since_common.bats
index 90a04aa..7100819 100644
--- a/tests/since_common.bats
+++ b/tests/since_common.bats
@@ -513,3 +513,36 @@ another plain line"
 		false
 	}
 }
+
+@test "library functions survive into an xargs/sh -c grandchild" {
+	# Collection scripts fan out with `xargs ... sh -c`, where a function from
+	# the parent shell is not visible. Without export -f the failure is quiet
+	# and expensive: $(since_find_predicate) becomes empty, find runs
+	# unfiltered, and the window is silently ignored. CNV's gather_vms_details
+	# collected a 27-minute-old QEMU log under --since 5m because of this.
+	run bash -c "
+		export MUST_GATHER_SINCE_TIME='2026-10-16T12:00:00Z'
+		source \"$SCRIPT_DIR/since_common.sh\"
+		get_since_cutoff
+		sh -c 'since_find_predicate'
+	"
+	assert_success
+	assert_output "-newermt @1792152000"
+}
+
+@test "every public library function is exported" {
+	run bash -c "
+		source \"$SCRIPT_DIR/since_common.sh\"
+		missing=''
+		for f in duration_to_seconds duration_to_node_logs_since get_since_cutoff \
+			since_window_requested since_find_predicate filename_timestamp_epoch \
+			filter_names_since copy_pod_dir_since pod_tar_dirs_since \
+			trim_jsonl_since since_report since_report_header; do
+			declare -F \"\$f\" >/dev/null || { missing=\"\$missing \$f(undefined)\"; continue; }
+			[[ \$(declare -pF \"\$f\") == *' -fx '* ]] || missing=\"\$missing \$f\"
+		done
+		echo \"[\$missing]\"
+	"
+	assert_success
+	assert_output "[]"
+}
