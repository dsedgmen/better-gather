From cb4ea295ff680c10e2e343c4a55abc7078780c6e Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Sat, 17 Oct 2026 09:02:37 +1000
Subject: [PATCH 05/28] Make --since mean something for the apiserver log
 directories

gather_audit_logs already forwards --since on both of its node-logs calls,
and its comment documents the fifth xargs argument as an ISO since. The
intent was always there; oc just never acted on it, so a --since 30m run at
05:53 still downloaded files rotated at 00:15, 01:33, 03:03 and 04:38.

The listing is now filtered by the timestamp in each rotated file's name, and
what is downloaded is trimmed by requestReceivedTimestamp, so the result
holds exactly the requested window rather than whole files. The
.audit_logs_listing file still records everything that existed on the node
before filtering, so it stays possible to see what was skipped.

For that same 05:53 run the kube-apiserver directory goes from 5 downloaded
files per master to 1.

gather_kas_startup_termination_logs lists the same directory and gets the
same treatment. No content trimming there: klog timestamps carry no year.

gather_windows_node_logs is deliberately left alone. It fetches a fixed set
of filenames rather than a rotated listing, so there is nothing for a window
to select between, and Windows service logs have no timestamp format worth
trimming on. It records itself as out of scope in the report instead of
appearing to have been considered and skipped.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 collection-scripts/gather_audit_logs          | 23 ++++++++++++++++---
 .../gather_kas_startup_termination_logs       |  9 ++++++++
 collection-scripts/gather_windows_node_logs   | 14 ++++++++++-
 3 files changed, 42 insertions(+), 4 deletions(-)

diff --git a/collection-scripts/gather_audit_logs b/collection-scripts/gather_audit_logs
index 87e5a27..f6a2133 100755
--- a/collection-scripts/gather_audit_logs
+++ b/collection-scripts/gather_audit_logs
@@ -9,6 +9,17 @@ get_log_collection_args
 
 BASE_COLLECTION_PATH="${BASE_COLLECTION_PATH:-/must-gather}"
 
+# oc drops --since for a --path request and the kubelet does not time-filter
+# file serving, so the arguments threaded through below have no effect on
+# their own. Apply the window here instead: skip rotated files that end before
+# the cutoff, and trim the events of the ones we do fetch.
+# shellcheck source=collection-scripts/since_common.sh
+SINCE_COMMON="$(dirname "$0")/since_common.sh"
+source "${SINCE_COMMON}"
+export SINCE_COMMON
+get_since_cutoff
+since_report_header
+
 profile=$(oc get apiservers.v1.config.openshift.io -o jsonpath='{.items[0].spec.audit.profile}')
 if [ -z "${profile}" ] || [ "${profile}" == None ]; then
 	if [ "${1}" == "--force" ]; then
@@ -43,16 +54,20 @@ paths=(openshift-apiserver kube-apiserver oauth-apiserver etcd oauth-server)
 for path in "${paths[@]}"; do
 	output_dir="${BASE_COLLECTION_PATH}/audit_logs/$path"
 	mkdir -p "$output_dir"
+	# The listing file records everything that exists on the node, before
+	# filtering, so it stays possible to see what was skipped and why.
 	oc adm node-logs ${node_log_collection_args:+"$node_log_collection_args"} --role=master --path="$path" |
 		tee "${BASE_COLLECTION_PATH}/audit_logs/$path.audit_logs_listing" |
 		grep -v ".terminating" |
 		grep -v ".lock" |
+		filter_names_since "audit_logs/$path" |
 		sed "s|^|$path $output_dir |" |
 		sed "s|$| '${node_log_collection_args}'|"
 done |
 	xargs --max-args=5 --max-procs=45 bash -c \
 		'echo "INFO: Started  downloading $1/$4 from $3";
-  oc adm node-logs ${5:+"$5"} $3 --path=$1/$4 | gzip > $2/$3-$4.gz;
+  source "${SINCE_COMMON}";
+  oc adm node-logs ${5:+"$5"} $3 --path=$1/$4 | trim_jsonl_since | gzip > $2/$3-$4.gz;
   echo "INFO: Finished downloading $1/$4 from $3"' \
 		bash
 
@@ -78,7 +93,8 @@ gather_monitoring_audit_logs() {
 			mkdir -p "$output_dir"
 
 			echo "Collecting logs from prometheus adapter pod: $pod"
-			oc cp -n openshift-monitoring "$pod:var/log/adapter" "$output_dir"
+			copy_pod_dir_since openshift-monitoring "$pod" "" \
+				var/log/adapter "$output_dir" "audit_logs/monitoring/$pod"
 		done
 	else
 		local metrics_server_pods
@@ -92,7 +108,8 @@ gather_monitoring_audit_logs() {
 			mkdir -p "$output_dir"
 
 			echo "Collecting logs from metrics server pod: $pod"
-			oc cp -n openshift-monitoring "$pod:var/log/metrics-server" "$output_dir"
+			copy_pod_dir_since openshift-monitoring "$pod" "" \
+				var/log/metrics-server "$output_dir" "audit_logs/monitoring/$pod"
 		done
 	fi
 }
diff --git a/collection-scripts/gather_kas_startup_termination_logs b/collection-scripts/gather_kas_startup_termination_logs
index e0e8f3c..6a52d1c 100755
--- a/collection-scripts/gather_kas_startup_termination_logs
+++ b/collection-scripts/gather_kas_startup_termination_logs
@@ -9,6 +9,14 @@ set -o pipefail
 source "$(dirname "$0")/common.sh"
 get_log_collection_args
 
+# oc drops --since for a --path request and the kubelet does not time-filter
+# file serving, so the arguments threaded through below have no effect on
+# their own. Apply the window here instead.
+# shellcheck source=collection-scripts/since_common.sh
+source "$(dirname "$0")/since_common.sh"
+get_since_cutoff
+since_report_header
+
 BASE_COLLECTION_PATH="${BASE_COLLECTION_PATH:-/must-gather}"
 
 echo "WARNING: Collecting one or more kube-apiserver related logs on ALL masters in your cluster. This could take a large amount of time." >&2
@@ -26,6 +34,7 @@ for path in "${paths[@]}"; do
 	mkdir -p "$output_dir"
 	oc adm node-logs ${node_log_collection_args:+"$node_log_collection_args"} --role=master --path="$path" |
 		grep -E '(startup.*.log|termination.log)' |
+		filter_names_since "static-pods/$path" |
 		sed "s|^|$path $output_dir |" |
 		sed "s|$| '${node_log_collection_args}'|"
 done |
diff --git a/collection-scripts/gather_windows_node_logs b/collection-scripts/gather_windows_node_logs
index 47f71a2..f0da24f 100755
--- a/collection-scripts/gather_windows_node_logs
+++ b/collection-scripts/gather_windows_node_logs
@@ -7,7 +7,13 @@ get_log_collection_args
 BASE_COLLECTION_PATH="/must-gather"
 WINDOWS_NODE_LOGS=$BASE_COLLECTION_PATH/host_service_logs/windows
 
-# Logfile list
+# Logfile list.
+#
+# These are fixed filenames, not a rotated listing, so there is nothing for
+# the --since window to select between: each file is fetched whole. oc drops
+# --since for a --path request anyway (it only applies it to journal queries),
+# and these are Windows service logs with no timestamp format we can trim on.
+# Recorded as out of scope in the --since report rather than silently ignored.
 LOGS=(kube-proxy/kube-proxy.log)
 LOGS+=(hybrid-overlay/hybrid-overlay.log)
 LOGS+=(kubelet/kubelet.log)
@@ -40,5 +46,11 @@ for log in "${LOGS[@]}"; do
 done
 wait "${PIDS[@]}"
 
+# shellcheck source=collection-scripts/since_common.sh
+source "$(dirname "$0")/since_common.sh"
+get_since_cutoff
+since_report_header
+since_report "windows_node_logs" "not-applicable-fixed-filenames" "${#LOGS[@]}" "0"
+
 # force disk flush to ensure that all data gathered is accessible in the copy container
 sync
-- 
