From 7831d94a445bc8125762889ef215dad9c5ab8933 Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Sat, 17 Oct 2026 09:01:55 +1000
Subject: [PATCH 01/28] Fix the shellcheck findings that make `make lint` fail

`make lint` fails out of the box: shellcheck 0.11.0, the version hack/tools.sh
pins, reports nine findings across gather_nfd and gather_virt, including one
error (SC2145, an array interpolated into a string).

All of them are cosmetic or annotations of deliberate behaviour -- the
unquoted ${log_collection_args} expansions are intentional word splitting and
are marked as such, matching how the rest of collection-scripts already
handles them. No behaviour changes.

Worth fixing first because a lint target that is always red cannot tell you
anything about the changes that follow it.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 collection-scripts/gather_nfd  |  7 ++++++-
 collection-scripts/gather_virt | 11 ++++++-----
 2 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/collection-scripts/gather_nfd b/collection-scripts/gather_nfd
index 06b7349..284d4b3 100755
--- a/collection-scripts/gather_nfd
+++ b/collection-scripts/gather_nfd
@@ -1,7 +1,10 @@
 #!/bin/bash
 
-source $(dirname "$0")/common.sh
+# shellcheck source=collection-scripts/common.sh
+source "$(dirname "$0")/common.sh"
 BASE_COLLECTION_PATH="must-gather"
+# operator_ns and log_collection_args are set by common.sh
+# shellcheck disable=SC2154
 get_operator_ns "nfd"
 get_log_collection_args
 
@@ -10,10 +13,12 @@ function get_nfd_crs() {
 
     for CRD in "${NFD_CRDS[@]}"; do
         echo "INFO: Collecting NFD Data for ${CRD} in namespace ${operator_ns}"
+        # shellcheck disable=SC2086,SC2154  # intentional word splitting
         oc adm inspect ${log_collection_args} --dest-dir "${BASE_COLLECTION_PATH}" "${CRD}" -n "${operator_ns}"
     done
 }
 
+# shellcheck disable=SC2086,SC2154  # intentional word splitting
 oc adm inspect ${log_collection_args} --dest-dir "${BASE_COLLECTION_PATH}" "ns/${operator_ns}"
 get_nfd_crs
 
diff --git a/collection-scripts/gather_virt b/collection-scripts/gather_virt
index 4804a82..3e9a169 100755
--- a/collection-scripts/gather_virt
+++ b/collection-scripts/gather_virt
@@ -1,6 +1,7 @@
 #!/bin/bash
 
-source $(dirname "$0")/common.sh
+# shellcheck source=collection-scripts/common.sh
+source "$(dirname "$0")/common.sh"
 BASE_COLLECTION_PATH="must-gather"
 VIRT_LOG_PATH="${BASE_COLLECTION_PATH}/virt_info"
 
@@ -20,19 +21,19 @@ declare -a VIRT_CRDS=(
   )
 
 function get_crd_stats() {
-  echo "Gathering stats for the following CRDs: ${VIRT_CRDS[@]}"
+  echo "Gathering stats for the following CRDs: ${VIRT_CRDS[*]}"
   mkdir -p "${VIRT_LOG_PATH}/crd"
 	for CRD in "${VIRT_CRDS[@]}";
   do
-    oc get -A --chunk-size=10000 $CRD -o NAME | wc -l > ${VIRT_LOG_PATH}/crd/$CRD.count
+    oc get -A --chunk-size=10000 "$CRD" -o NAME | wc -l >"${VIRT_LOG_PATH}/crd/$CRD.count"
   done
 }
 
 function summarize() {
   echo "Stats"
-  for FN in ${VIRT_LOG_PATH}/crd/*;
+  for FN in "${VIRT_LOG_PATH}"/crd/*;
   do
-    echo "$(basename $FN) $(cat $FN)"
+    echo "$(basename "$FN") $(cat "$FN")"
   done | column --table --table-right 1
 }
 
