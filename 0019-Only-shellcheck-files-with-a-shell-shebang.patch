From d483859d5a0f312ca5a879f876598dd461c6dc2d Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Sat, 17 Oct 2026 13:02:56 +1000
Subject: [PATCH 19/28] Only shellcheck files with a shell shebang

Adding hack/backport_edits.py broke both lint targets: the shebang test
matched any '#!' and shellcheck was handed a Python script, which it
correctly refuses (SC1071). Match sh/bash/dash/ksh/zsh specifically.

The backport also carries the gather_nfd and gather_virt lint fixes, so
bats-lint is green on a release branch as well.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 Makefile               |  4 ++--
 hack/backport_edits.py | 28 +++++++++++++++++++++++++++-
 2 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/Makefile b/Makefile
index fa1310f..d4830ba 100644
--- a/Makefile
+++ b/Makefile
@@ -49,7 +49,7 @@ SCRIPT_DIRS := collection-scripts/ hack/ tests/
 
 .PHONY: lint
 lint: shellcheck
-	find $(SCRIPT_DIRS) -type f -exec grep -Eq '^#!/' {} \; -exec $(SHELLCHECK) -x {} +
+	find $(SCRIPT_DIRS) -type f -exec grep -Eq '^#!.*/(env +)?(ba|da|k|z)?sh\b' {} \; -exec $(SHELLCHECK) -x {} +
 
 .PHONY: fmt
 fmt: shfmt
@@ -105,7 +105,7 @@ $(TOOLS):
 .PHONY: bats-lint
 bats-lint: shellcheck
 	find $(SCRIPT_DIRS) -type f -not -path '*/vendor/*' \
-		-exec grep -Eq '^#!/' {} \; -exec $(SHELLCHECK) -x {} +
+		-exec grep -Eq '^#!.*/(env +)?(ba|da|k|z)?sh\b' {} \; -exec $(SHELLCHECK) -x {} +
 
 .PHONY: bats-test
 bats-test: bats
diff --git a/hack/backport_edits.py b/hack/backport_edits.py
index 4122efa..ca96630 100755
--- a/hack/backport_edits.py
+++ b/hack/backport_edits.py
@@ -163,6 +163,32 @@ else
 ''',
         required=False, label="insights: bounded copy")
 
+# --------------------------------------------------------------------------
+# Pre-existing shellcheck findings, so `make bats-lint` is green on the
+# branch too. Same fixes as on main; annotations of deliberate behaviour
+# rather than behaviour changes.
+# --------------------------------------------------------------------------
+
+edit(f"{CS}/gather_nfd",
+     'source $(dirname "$0")/common.sh',
+     '# shellcheck source=collection-scripts/common.sh\nsource "$(dirname "$0")/common.sh"',
+     required=False, label="gather_nfd: quote source")
+
+edit_re(f"{CS}/gather_nfd",
+        r'(\n)([ \t]*oc adm inspect \$\{log_collection_args\})',
+        r'\1        # shellcheck disable=SC2086,SC2154  # intentional word splitting\n\2',
+        required=False, label="gather_nfd: disable directives")
+
+edit(f"{CS}/gather_virt",
+     'source $(dirname "$0")/common.sh',
+     '# shellcheck source=collection-scripts/common.sh\nsource "$(dirname "$0")/common.sh"',
+     required=False, label="gather_virt: quote source")
+
+edit(f"{CS}/gather_virt",
+     'echo "Gathering stats for the following CRDs: ${VIRT_CRDS[@]}"',
+     'echo "Gathering stats for the following CRDs: ${VIRT_CRDS[*]}"',
+     required=False, label="gather_virt: array in string")
+
 # --------------------------------------------------------------------------
 # Makefile: shell lint and tests, self-contained
 # --------------------------------------------------------------------------
@@ -190,7 +216,7 @@ $(BG_LOCALBIN)/%:
 .PHONY: bats-lint
 bats-lint: $(BG_SHELLCHECK)
 \tfind $(BG_SCRIPT_DIRS) -type f -not -path '*/vendor/*' \\
-\t\t-exec grep -Eq '^#!/' {} \\; -exec $(BG_SHELLCHECK) -x {} +
+\t\t-exec grep -Eq '^#!.*/(env +)?(ba|da|k|z)?sh\b' {} \\; -exec $(BG_SHELLCHECK) -x {} +
 
 .PHONY: bats-test
 bats-test: $(BG_BATS)
-- 
