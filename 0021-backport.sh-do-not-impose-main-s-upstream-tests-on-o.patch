From 9e592f46300d006b878c238b26ebc84f4cc527b6 Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Sat, 17 Oct 2026 13:05:40 +1000
Subject: [PATCH 21/28] backport.sh: do not impose main's upstream tests on
 older branches

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 hack/backport.sh       | 11 +++++++----
 hack/backport_edits.py | 14 ++++++++++++++
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/hack/backport.sh b/hack/backport.sh
index e531cde..70c9631 100755
--- a/hack/backport.sh
+++ b/hack/backport.sh
@@ -76,11 +76,14 @@ backport_one() {
 			echo "  note: ${SOURCE_BRANCH} has no ${f}"
 	done
 
-	# Older release branches predate the bats suite entirely; they get the
-	# whole tests/ directory and the Makefile targets from us.
+	# Deliberately *not* copying main's tests/ wholesale onto branches that
+	# have none of their own. main's common.bats asserts upstream behaviour
+	# that differs by release -- REDUCE_LOGS and rotated-pod-logs handling
+	# do not exist in the 4.18-era common.sh -- so it would fail for reasons
+	# that have nothing to do with this backport. Only the three files that
+	# test *our* code come across, and they are in OURS above.
 	if [ ! -f tests/common.bats ]; then
-		git checkout -q "${SOURCE_BRANCH}" -- tests/ 2>/dev/null || true
-		echo "  note: branch had no tests/, took the suite from ${SOURCE_BRANCH}"
+		echo "  note: branch has no upstream bats suite; testing our code only"
 	fi
 
 	python3 hack/backport_edits.py || return 1
diff --git a/hack/backport_edits.py b/hack/backport_edits.py
index da0be0c..da88ee6 100755
--- a/hack/backport_edits.py
+++ b/hack/backport_edits.py
@@ -189,6 +189,20 @@ edit(f"{CS}/gather_virt",
      'echo "Gathering stats for the following CRDs: ${VIRT_CRDS[*]}"',
      required=False, label="gather_virt: array in string")
 
+# --------------------------------------------------------------------------
+# The branch's own test for the duration collapse, where it has one. Upstream
+# codified the truncation as expected behaviour, so it has to move with the
+# fix or the suite fails on its own assertion.
+# --------------------------------------------------------------------------
+
+edit("tests/common.bats",
+     'assert_output --partial "node_log_collection_args=--since=-2h"',
+     '# node-logs takes a single component, so the duration is collapsed --\n'
+     '\t# but exactly, not by truncation. Keeping only the first component\n'
+     '\t# yields -2h and silently drops the oldest 30 minutes.\n'
+     '\tassert_output --partial "node_log_collection_args=--since=-150m"',
+     required=False, label="common.bats: duration expectation")
+
 # --------------------------------------------------------------------------
 # Makefile: shell lint and tests, self-contained
 # --------------------------------------------------------------------------
-- 
2.56.0

