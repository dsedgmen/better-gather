From 5d082cfeb24e614093b5ae45628cd8a4a7c20e86 Mon Sep 17 00:00:00 2001
From: David Sedgmen <dsedgmen@redhat.com>
Date: Sat, 17 Oct 2026 09:49:25 +1000
Subject: [PATCH 10/28] try-on-cluster: carry the launcher inside base64 too

The in-pod command is placed in an unquoted heredoc by oc, so a bare $PATH
or any $(...) in a caller-supplied argument is expanded on the machine
running the command rather than in the pod. Caught while adapting this for
ODF, whose entrypoint needs a PATH export: the pod would have been handed
the laptop's PATH.

The launcher is now built as a script, base64'd and decoded in the pod
alongside the collection scripts, with arguments run through printf %q. The
in-pod command now contains no shell metacharacters at all, which the
dry-run output makes checkable.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 hack/tools-from-packages.sh | 19 +++++++++++++++----
 hack/try-on-cluster.sh      | 34 ++++++++++++++++++++++++++++------
 2 files changed, 43 insertions(+), 10 deletions(-)

diff --git a/hack/tools-from-packages.sh b/hack/tools-from-packages.sh
index e2fdd1e..659772c 100755
--- a/hack/tools-from-packages.sh
+++ b/hack/tools-from-packages.sh
@@ -59,10 +59,21 @@ fetch_package() {
 
 	echo "INFO: downloading ${package} from the configured repositories"
 	# --destdir keeps it out of the working tree; no root needed.
-	dnf download --quiet --destdir "$RPM_CACHE" "$package" >/dev/null 2>&1 || {
-		echo "ERROR: ${package} is not available from the configured repositories" >&2
-		return 1
-	}
+	#
+	# Try the distribution repositories first. A third-party repo that
+	# happens to be configured can prompt to import a GPG key, which blocks
+	# a non-interactive run over a key we have no need for. The fallback
+	# passes -y so that prompt cannot hang the build either.
+	if dnf download --quiet --destdir "$RPM_CACHE" \
+		--repo=fedora --repo=updates "$package" >/dev/null 2>&1; then
+		return 0
+	fi
+	if dnf download -y --quiet --destdir "$RPM_CACHE" "$package" >/dev/null 2>&1; then
+		return 0
+	fi
+
+	echo "ERROR: ${package} is not available from the configured repositories" >&2
+	return 1
 }
 
 unpack_package() {
diff --git a/hack/try-on-cluster.sh b/hack/try-on-cluster.sh
index 5d4e993..6c1f227 100755
--- a/hack/try-on-cluster.sh
+++ b/hack/try-on-cluster.sh
@@ -84,21 +84,43 @@ if ! [[ "$payload" =~ ^[A-Za-z0-9+/=]+$ ]]; then
 fi
 
 # Single argv element, so oc's strings.Join leaves it intact.
+# The launcher travels base64-encoded too, not inlined. oc drops the command
+# into an *unquoted* heredoc, so any $ or $(...) in an argument the caller
+# passed would be expanded on this machine rather than in the pod.
+launcher="#!/bin/bash
+set -eu
+echo 'INFO: running ${script} from the working tree'
+exec ${POD_DIR}/${script}"
+for arg in ${script_args+"${script_args[@]}"}; do
+	launcher+=" $(printf '%q' "$arg")"
+done
+launcher+="
+"
+launcher_b64="$(printf '%s' "$launcher" | base64 -w0)"
+
+for blob in "$payload" "$launcher_b64"; do
+	if ! [[ "$blob" =~ ^[A-Za-z0-9+/=]+$ ]]; then
+		echo "ERROR: payload is not pure base64; oc's heredoc would mangle it" >&2
+		exit 1
+	fi
+done
+
 remote_cmd="echo '${payload}' | base64 -d >/tmp/bg.tgz"
 remote_cmd+=" && mkdir -p ${POD_DIR}"
 remote_cmd+=" && tar xzf /tmp/bg.tgz -C ${POD_DIR} --strip-components=1"
 remote_cmd+=" && chmod +x ${POD_DIR}/*"
-remote_cmd+=" && echo 'INFO: running ${script} from the working tree'"
-remote_cmd+=" && ${POD_DIR}/${script}"
-for arg in ${script_args+"${script_args[@]}"}; do
-	remote_cmd+=" ${arg}"
-done
+remote_cmd+=" && echo '${launcher_b64}' | base64 -d >/tmp/bg-run.sh"
+remote_cmd+=" && bash /tmp/bg-run.sh"
 
 if [[ "$dry_run" == true ]]; then
 	echo "oc adm must-gather ${oc_args[*]-} -- <${#payload} char payload>"
 	echo
 	echo "--- in-pod command (payload elided) ---"
-	echo "${remote_cmd/${payload}/<base64 of collection-scripts/>}"
+	local_view="${remote_cmd/${payload}/<base64 of collection-scripts/>}"
+	echo "${local_view/${launcher_b64}/<base64 of launcher>}"
+	echo
+	echo "--- launcher (decoded) ---"
+	printf '%s\n' "$launcher"
 	exit 0
 fi
 
