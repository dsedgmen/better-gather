diff --git a/Dockerfile.overlay b/Dockerfile.overlay
new file mode 100644
index 0000000..0ac7611
--- /dev/null
+++ b/Dockerfile.overlay
@@ -0,0 +1,21 @@
+# Layer better-gather's collection scripts onto an existing must-gather image.
+#
+# Dockerfile.ocp builds from registry.ci.openshift.org, which needs CI
+# credentials and produces an image a cluster cannot necessarily pull. For
+# testing against a real cluster it is simpler and more faithful to overlay
+# the scripts onto the must-gather image that cluster already runs: the base
+# is then guaranteed to be version-matched and pullable, and the only
+# difference from stock is the thing being tested.
+#
+#   make image-overlay BASE=$(oc adm release info --image-for=must-gather)
+#
+# The base already carries jq (Dockerfile.ocp installs it), which
+# trim_jsonl_since needs.
+
+ARG BASE=quay.io/openshift/origin-must-gather:latest
+FROM ${BASE}
+
+COPY collection-scripts/* /usr/bin/
+
+LABEL io.k8s.display-name="better-gather" \
+      io.k8s.description="must-gather collection scripts that honour --since"
diff --git a/Makefile b/Makefile
index d01f6cb..f5eaaf9 100644
--- a/Makefile
+++ b/Makefile
@@ -34,6 +34,16 @@ $(call build-image,ocp-must-gather,$(IMAGE_REGISTRY)/ocp/4.17:ocp-must-gather, .
 
 $(call verify-golang-versions,Dockerfile.ocp)
 
+# Overlay build: layer the collection scripts onto an existing must-gather
+# image, so the base is version-matched to the cluster under test and needs no
+# CI credentials. See Dockerfile.overlay.
+BASE ?= quay.io/openshift/origin-must-gather:latest
+OVERLAY_IMAGE ?= better-gather:latest
+
+.PHONY: image-overlay
+image-overlay:
+	podman build --build-arg BASE=$(BASE) -t $(OVERLAY_IMAGE) -f Dockerfile.overlay .
+
 # Directories containing shell scripts to lint and format
 SCRIPT_DIRS := collection-scripts/ hack/ tests/
 
